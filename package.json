{
  "name": "jevsql",
  "version": "0.1.0",
  "description": "Decision tables for AI-era databases: semantic matching, source-backed extraction, evidence checks, change history and measured review queues, powered by TypeSafe Jev.",
  "type": "module",
  "main": "src/engine.mjs",
  "exports": {
    "./rows": "./src/rows.mjs",
    "./pg-cache": "./src/pg-cache.mjs",
    ".": "./src/engine.mjs",
    "./client": "./src/client.mjs",
    "./cache": "./src/cache.mjs",
    "./control": "./src/control-plane.mjs",
    "./schema": "./src/schema.mjs",
    "./telemetry": "./src/telemetry.mjs",
    "./metrics": "./src/metrics.mjs",
    "./adapters": "./src/adapters.mjs",
    "./queries": "./src/query-compiler.mjs",
    "./evaluation": "./src/evaluation.mjs",
    "./function-router": "./src/function-router.mjs",
    "./date-extraction": "./src/date-extraction.mjs",
    "./hierarchy": "./src/hierarchy.mjs",
    "./app-types": "./src/app-types.mjs",
    "./candidates": "./src/candidates.mjs",
    "./corpus": "./src/corpus.mjs",
    "./escalation": "./src/escalation.mjs",
    "./hazards": "./src/hazards.mjs",
    "./injection": "./src/injection.mjs",
    "./lineage": "./src/lineage.mjs",
    "./migrations": "./src/migration-runner.mjs",
    "./operations": "./src/operations.mjs",
    "./seed": "./src/seed.mjs",
    "./semantic-layer": "./src/semantic-layer.mjs",
    "./shadow": "./src/shadow.mjs"
  },
  "bin": { "jevsql": "bin/jevsql.mjs" },
  "files": ["src", "bin", "examples", "docs", "README.md", "LICENSE"],
  "engines": { "node": ">=22.16" },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=86 --test-coverage-functions=95 \"test/**/*.test.mjs\"",
    "test:databases": "node --test test/real-adapters.test.mjs",
    "test:mutation": "stryker run",
    "demo": "node examples/demo.mjs",
    "control": "node examples/control-plane.mjs",
    "workflows": "node examples/workflows.mjs",
    "showcase": "node examples/showcase.mjs",
    "contrast": "node examples/contrast.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "mysql2": "^3.14.5",
    "pg": "^8.16.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "keywords": ["typesafe", "jev", "system-one", "sql", "sqlite", "llm", "classification", "semantic-sql", "ai-database"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/EugeneBoondock/jevsql.git" },
  "bugs": { "url": "https://github.com/EugeneBoondock/jevsql/issues" },
  "homepage": "https://github.com/EugeneBoondock/jevsql#readme"
}
